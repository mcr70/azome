    "proxyPort": { "type": "number" },
    "delegateTarget": { "type": "string" },
    "port": { "type": "number" },
    "host": { "type": "string" },
    "open": { "type": "boolean" },
    "poll": { "type": "number" },
    "watch": { "type": "boolean" },
    "verbose": { "type": "boolean" },
    "liveReload": { "type": "boolean" },
    "hmr": { "type": "boolean" }
